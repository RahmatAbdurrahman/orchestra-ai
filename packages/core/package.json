    "bullmq": "5.81.5",
    "ioredis": "5.11.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "29.7.0",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  }
