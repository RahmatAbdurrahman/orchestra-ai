{
  "name": "@orchestra/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations, seed data and the generated Prisma client",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./seed": {
      "types": "./dist/seed-data.d.ts",
      "default": "./dist/seed-data.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:deploy": "node scripts/with-env.mjs prisma migrate deploy",
    "migrate:status": "node scripts/with-env.mjs prisma migrate status",
    "seed": "node scripts/with-env.mjs node dist/seed.js",
    "test": "echo \"(database: covered by API integration tests)\""
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@orchestra/domain": "workspace:*",
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "typescript": "5.9.3"
  }
}
