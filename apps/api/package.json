{
  "name": "@orchestra/api",
  "version": "0.1.0",
  "private": true,
  "description": "Orchestra AI NestJS API (modular monolith)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "test": "jest --config jest.config.js",
    "test:integration": "jest --config jest.integration.config.js --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-express": "11.2.10",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.8.0",
    "@node-rs/argon2": "2.2.2",
    "@orchestra/core": "workspace:*",
    "@orchestra/database": "workspace:*",
    "@orchestra/domain": "workspace:*",
    "@orchestra/uipath-client": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.10",
    "@orchestra/erp-simulation": "workspace:*",
    "@orchestra/uipath-orchestrator-mock": "workspace:*",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "29.7.0",
    "supertest": "^7.1.4",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  }
}
