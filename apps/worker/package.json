{
  "name": "@orchestra/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Orchestra AI background worker: BullMQ processors for document intelligence and UiPath automation, plus restart reconciliation",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "test": "jest --passWithNoTests",
    "test:integration": "jest --config jest.integration.config.js --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@orchestra/core": "workspace:*",
    "@orchestra/database": "workspace:*",
    "@orchestra/domain": "workspace:*",
    "@orchestra/uipath-client": "workspace:*",
    "bullmq": "5.81.5",
    "ioredis": "5.11.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "29.7.0",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  }
}
