# Orchestra AI - environment template
# Copy to .env for local development. Docker Compose has its own values in docker-compose.yml.
# All secrets below are placeholders for local development only. Never commit a real .env.

# ---------------------------------------------------------------- shared
NODE_ENV=development
DATABASE_URL=postgresql://orchestra:orchestra@localhost:5432/orchestra?schema=public
REDIS_URL=redis://localhost:6379
# bullmq (default; requires Redis and apps/worker) | inline (development/tests only, runs jobs in the API process)
QUEUE_DRIVER=bullmq
# Must point to the same directory for the API and the worker (relative paths resolve from apps/*)
UPLOAD_DIR=../../storage/uploads

# ---------------------------------------------------------------- API
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
TRUST_PROXY=false
SWAGGER_ENABLED=true
SESSION_TTL_HOURS=12
RBAC_ADMIN_CAN_APPROVE=false
RBAC_ADMIN_CAN_OPERATE_AUTOMATION=false
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# One-click sign-in as a seeded account on the login page (simulations only; refused when NODE_ENV=production)
DEMO_LOGIN_ENABLED=false

# ---------------------------------------------------------------- document intelligence (Python)
DOCUMENT_INTELLIGENCE_URL=http://localhost:8000
DOCUMENT_INTELLIGENCE_TOKEN=dev-internal-token-change-me
OCR_ENGINE=tesseract
OCR_LANGUAGES=eng+ind

# ---------------------------------------------------------------- UiPath Orchestrator
# Local development uses the mock (services/uipath-orchestrator-mock). For a real tenant see docs/uipath-integration.md:
#   UIPATH_MODE=cloud
#   UIPATH_ORCHESTRATOR_URL=https://cloud.uipath.com/<organization>/<tenant>/orchestrator_
#   UIPATH_IDENTITY_URL=https://cloud.uipath.com/identity_/connect/token
UIPATH_MODE=mock
UIPATH_ORCHESTRATOR_URL=http://localhost:4200
UIPATH_IDENTITY_URL=http://localhost:4200/identity_/connect/token
UIPATH_CLIENT_ID=orchestra-local
UIPATH_CLIENT_SECRET=dev-uipath-secret-change-me
UIPATH_SCOPES=OR.Jobs OR.Execution.Read OR.Folders.Read
UIPATH_FOLDER_ID=1
UIPATH_PROCESS_NAME=PurchaseOrderAutomation
UIPATH_REQUEST_TIMEOUT_MS=15000
UIPATH_MOCK_PORT=4200
UIPATH_MOCK_ADMIN_TOKEN=dev-mock-admin-change-me

# ---------------------------------------------------------------- ERP simulation
ERP_PORT=4100
ERP_SIMULATION_URL=http://localhost:4100
ERP_USERNAME=robot.erp
ERP_PASSWORD=dev-erp-password-change-me
ERP_API_TOKEN=dev-erp-api-token-change-me
ERP_SIM_ADMIN_TOKEN=dev-erp-admin-change-me
ERP_DATABASE_PATH=../../.data/erp-simulation.sqlite

# ---------------------------------------------------------------- web
API_INTERNAL_URL=http://localhost:4000
# Bearer token the web proxy adds when the API sits behind an authenticating gateway
# (e.g. a private Hugging Face Space: an HF access token with read access). Leave empty locally.
API_INTERNAL_AUTH_TOKEN=

# ---------------------------------------------------------------- seed (development only)
SEED_DEFAULT_PASSWORD="Orchestra#2026"
