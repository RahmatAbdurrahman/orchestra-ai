{
  "name": "orchestra-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Orchestra AI - intelligent enterprise automation platform (Purchase Request to Purchase Order with UiPath)",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --filter \"!@orchestra/e2e\" run test",
    "test:integration": "pnpm --filter @orchestra/api run test:integration",
    "test:e2e": "pnpm --filter @orchestra/e2e run test",
    "db:generate": "pnpm --filter @orchestra/database run generate",
    "db:migrate": "pnpm --filter @orchestra/database run migrate:deploy",
    "db:seed": "pnpm --filter @orchestra/database run seed",
    "dev:api": "pnpm --filter @orchestra/api run dev",
    "dev:worker": "pnpm --filter @orchestra/worker run dev",
    "dev:web": "pnpm --filter @orchestra/web run dev",
    "dev:erp": "pnpm --filter @orchestra/erp-simulation run dev",
    "dev:uipath-mock": "pnpm --filter @orchestra/uipath-orchestrator-mock run dev",
    "demo:data": "node scripts/demo-data.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "msgpackr-extract",
      "@nestjs/core",
      "sharp",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ]
  }
}
