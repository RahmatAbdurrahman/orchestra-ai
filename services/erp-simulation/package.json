{
  "name": "@orchestra/erp-simulation",
  "version": "0.1.0",
  "private": true,
  "description": "Simulated ERP (purchase order entry) that the UiPath robot operates through its web UI. Enforces idempotency keys.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.build.json && node --disable-warning=ExperimentalWarning dist/server.js",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "test": "jest"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.3",
    "jest": "29.7.0",
    "supertest": "^7.1.4",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  }
}
